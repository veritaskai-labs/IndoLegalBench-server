# Salin file ini jadi .env lalu isi nilainya.
# JANGAN pernah commit file .env yang sudah terisi.

APP_ENV=local
DEBUG=true

# Database
# Postgres (setelah SCRUM-89): postgresql+psycopg://indolegalbench:indolegalbench@localhost:5432/indolegalbench
# Local smoke without Alembic: sqlite:///./local.db  (gitignored; create_all on boot)
DATABASE_URL=postgresql+psycopg://indolegalbench:indolegalbench@localhost:5432/indolegalbench

# Origin frontend yang boleh mengakses API
CORS_ORIGINS=["http://localhost:3000"]

# OIDC. fake = CI/local without Cloud (refused when APP_ENV=staging|production).
# zitadel = your instance (restart uvicorn after change).
AUTH_OIDC_MODE=fake
PUBLIC_BASE_URL=http://localhost:8000
# TEMPORARY local smoke without frontend. MUST unset before staging.
# Cookie is bound to this host (localhost), not 127.0.0.1.
AUTH_DONE_URL_OVERRIDE=http://localhost:8000/auth/done

# --- Personal Zitadel Console (once; not Veritask tenant) ---
# 1. https://zitadel.cloud → create instance. Issuer = https://<id>.zitadel.cloud (no trailing slash)
# 2. Project → Application: Web, Authorization Code + PKCE (public; leave CLIENT_SECRET empty)
# 3. Redirect URI (exact): http://localhost:8000/auth/callback
# 4. Post-logout URI (exact): http://localhost:3000/login
# 5. Enable HTTP/localhost (development mode)
# 6. Create a human user; copy User ID → DEV_ZITADEL_SUB (that is OIDC sub)
# 7. ID token must include nonce; audience = client id (leave ZITADEL_AUDIENCE empty)
#
# Smoke: AUTH_OIDC_MODE=zitadel DATABASE_URL=sqlite:///./local.db
#   GET http://localhost:8000/auth/login → Zitadel login → /auth/callback → cookie + /auth/done
#   GET /me with cookie; unknown Zitadel user → 403 USER_NOT_REGISTERED; POST /auth/logout
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=fake-client
ZITADEL_AUDIENCE=
ZITADEL_CLIENT_SECRET=
ZITADEL_REDIRECT_URI=http://localhost:8000/auth/callback
# TODO(SCRUM-89): drop DEV_ZITADEL_SUB; official seed maps real subs
DEV_ZITADEL_SUB=

# Sesi
IDLE_TIMEOUT_MINUTES=30
# Absolute session cap in minutes (12 hours). Proposal; confirm with the client.
ABSOLUTE_SESSION_LIFETIME_MINUTES=720
SESSION_COOKIE_NAME=veritask_session
COOKIE_SECURE=false

# Kunci enkripsi kredensial produk AI, dipakai PBI-10.
# Hasilkan dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# PBI-18 AC7: koneksi role ilb_retention khusus job retensi harian (bukan
# DATABASE_URL). Masa simpan tetap 90 hari. Kosong = job tidak jalan.
AUDIT_RETENTION_DATABASE_URL=

# PBI-11 AC5: perkiraan biaya pengukuran. Harga dan kurs tidak punya nilai
# bawaan; sampai diisi, ringkasan pengukuran menjawab 500.
# Margin pengaman dalam persen (bawaan 20).
# COST_SAFETY_MARGIN_PERCENT=20
# Harga USD per 1 juta token output, kunci provider_type:model_name (huruf besar
# kecil dibedakan, harus sama dengan produk yang terdaftar). Contoh di bawah
# diambil dari halaman harga resmi DeepSeek dan Gemini pada 2026-10-30, memakai
# harga tertinggi (peak, harga mendatang, tier prompt besar). Verifikasi ulang.
# COST_MODEL_PRICES={"openai_compatible:deepseek-flash": "1.2", "openai_compatible:deepseek-v4-pro": "3.96", "gemini_interactions:gemini-3.5-flash-lite": "2.5", "gemini_interactions:gemini-3.8-flash": "7.5", "gemini_interactions:gemini-4-argon": "20", "gemini_interactions:gemini-2.5-pro": "15", "gemini_interactions:gemini-3.1-pro-preview": "18"}
# Rata-rata token jawaban untuk produk yang belum punya riwayat pengukuran.
# Aturannya masih TBA di tiket; tanpa nilai, produk tanpa riwayat dijawab 500.
# COST_DEFAULT_AVG_ANSWER_TOKENS=
# Kurs USD ke rupiah cadangan, dipakai bila JISDOR belum pernah berhasil diambil.
# COST_USD_IDR_FALLBACK_RATE=
# Kurs harian JISDOR dari layanan pihak ketiga. Key kosong = tidak memanggil
# layanan. Jangan pernah di-commit.
# JISDOR_API_URL=https://allratestoday.com/api/v1/central-bank/bi/latest
# JISDOR_API_KEY=
