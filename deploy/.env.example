# Copy to deploy/.env on the VM and fill in. Never commit the real file.
# One per stack: prod lives in /opt/indolegalbench, dev in /opt/indolegalbench-dev.
# The values below are for dev; the prod ones are in the comments.

# Keeps the two stacks' containers and networks apart. prod: ilb-prod.
COMPOSE_PROJECT_NAME=ilb-dev

# The database volume. dev keeps the one from the single-stack layout, which
# holds the Sprint 1 data and users linked to auth8. prod: ilb-prod_postgres_data.
POSTGRES_VOLUME=deploy_postgres_data

# Image tag and the names Caddy reaches this stack by. prod or dev, must match
# deploy/proxy/Caddyfile.
STACK=dev

# staging for dev, production for prod. Both refuse fake login.
APP_ENV=staging

# Branch deploy.sh pulls. dev: staging. prod: main (release PRs only).
DEPLOY_BRANCH=staging

# prod: indolegalbench.veritask.ai and api.indolegalbench.veritask.ai
WEB_DOMAIN=dev.indolegalbench.veritask.ai
API_DOMAIN=devapi.indolegalbench.veritask.ai

# Generate with: openssl rand -hex 24
# Hex only, so it can go into DATABASE_URL without URL-encoding.
# Different per stack.
POSTGRES_PASSWORD=

# Veritask has two Zitadel instances: auth8 is development, auth is production.
# prod: https://auth.veritask.ai
ZITADEL_ISSUER=https://auth8.veritask.ai
# Client ID of the IndoLegalBench application in that instance (differs per stack).
# Not a secret for a public PKCE client, but kept out of this public repo.
ZITADEL_CLIENT_ID=

# Encrypts the AI product credentials (PBI-10). Generate once with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Different per stack. Keep a copy outside the VM. It is not in the database
# dumps, and if it changes or is lost every stored credential becomes
# unreadable and has to be entered again.
CREDENTIAL_ENCRYPTION_KEY=

# Where the client repo is checked out, relative to this folder.
CLIENT_DIR=../../IndoLegalBench-client

# Where backup.sh writes. prod: /var/backups/indolegalbench
BACKUP_DIR=/var/backups/indolegalbench-dev
