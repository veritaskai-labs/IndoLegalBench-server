# Copy to deploy/.env on the VM and fill in. Never commit the real file.

WEB_DOMAIN=indolegalbench.veritask.ai
API_DOMAIN=api.indolegalbench.veritask.ai

# Generate with: openssl rand -hex 24
# Hex only, so it can go into DATABASE_URL without URL-encoding.
POSTGRES_PASSWORD=

ZITADEL_ISSUER=https://auth8.veritask.ai
# Client ID of the IndoLegalBenchFrontend app in Veritask's Zitadel.
# Not a secret for a public PKCE client, but kept out of this public repo.
ZITADEL_CLIENT_ID=

# Encrypts the AI product credentials (PBI-10). Generate once with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Keep a copy outside the VM. It is not in the database dumps, and if it
# changes or is lost every stored credential becomes unreadable and has to
# be entered again.
CREDENTIAL_ENCRYPTION_KEY=

# Where the client repo is checked out, relative to this folder.
CLIENT_DIR=../../IndoLegalBench-client
